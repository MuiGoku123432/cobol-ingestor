# =============================================================================
# cobol-graph Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Lines marked [REQUIRED] must be set. Lines marked [OPTIONAL] have sensible
# defaults shown after the "=". Commented-out lines show the default value.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# [OPTIONAL] Base directory for persistent data (tokens, sessions, etc.)
# COBOL_GRAPH_DATA_DIR=~/.cobol-graph

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Choose one provider. Each provider has its own required/optional fields below.
# Values: "anthropic", "copilot", "vertex", "bedrock", "openai"

# [REQUIRED] Which LLM backend to use
LLM_PROVIDER=anthropic

# --- Provider: Anthropic (LLM_PROVIDER=anthropic) ---

# [REQUIRED for anthropic] Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# --- Provider: GitHub Copilot (LLM_PROVIDER=copilot) ---

# [OPTIONAL] GitHub OAuth token. If omitted, run `cobol-graph auth login`
# to authenticate via the GitHub device flow (token is cached automatically).
# COPILOT_GITHUB_TOKEN=gho_...

# [OPTIONAL] Account type: "individual", "business", or "enterprise"
# COPILOT_ACCOUNT_TYPE=individual

# --- Provider: Google Vertex AI (LLM_PROVIDER=vertex) ---
# Uses Application Default Credentials for auth.

# [REQUIRED for vertex] Google Cloud project ID
# VERTEX_PROJECT_ID=my-gcp-project

# [OPTIONAL] Google Cloud region
# VERTEX_REGION=us-east5

# --- Provider: AWS Bedrock (LLM_PROVIDER=bedrock) ---
# Uses the standard AWS credential chain for auth (no explicit key needed).

# [OPTIONAL] AWS region
# BEDROCK_REGION=us-east-1

# [OPTIONAL] Bedrock model ID override
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0

# --- Provider: OpenAI (LLM_PROVIDER=openai) ---

# [REQUIRED for openai] OpenAI API key (or Azure APIM subscription key)
# OPENAI_API_KEY=sk-...

# [OPTIONAL] Base URL for Azure OpenAI or proxy endpoints
# OPENAI_BASE_URL=

# [OPTIONAL] OpenAI organization ID
# OPENAI_ORG_ID=

# [OPTIONAL] Model name (for Azure, this must match your deployment name)
# OPENAI_MODEL=gpt-4o

# [OPTIONAL] Enable Azure OpenAI mode (api-key header, /deployments/ path, api-version param)
# OPENAI_AZURE=false

# [OPTIONAL] Azure API version (only used when OPENAI_AZURE=true)
# OPENAI_API_VERSION=2025-04-01-preview

# -----------------------------------------------------------------------------
# LLM Timeouts
# -----------------------------------------------------------------------------

# [OPTIONAL] Overall HTTP client timeout (Go duration string)
# LLM_TIMEOUT=600s

# [OPTIONAL] Time to wait for the first response byte
# LLM_RESPONSE_HEADER_TIMEOUT=300s

# -----------------------------------------------------------------------------
# Claude Model Settings (used by all providers)
# -----------------------------------------------------------------------------

# [OPTIONAL] Model IDs (auto-resolved for Copilot provider)
# CLAUDE_OPUS_MODEL=claude-opus-4-6
# CLAUDE_SONNET_MODEL=claude-sonnet-4-6

# [OPTIONAL] Max retry attempts on transient failures
# CLAUDE_MAX_RETRIES=3

# [OPTIONAL] Output token limits per pass (increase if responses are truncated)
# CLAUDE_PASS1_MAX_TOKENS=8192
# CLAUDE_PASS2_MAX_TOKENS=16000
# CLAUDE_PASS3_MAX_TOKENS=16000
# CLAUDE_PASS4_MAX_TOKENS=4000

# [OPTIONAL] Remove the 2 req/s LLM rate limit (use with caution)
# DISABLE_RATE_LIMIT=false

# -----------------------------------------------------------------------------
# Neo4j
# -----------------------------------------------------------------------------

# [REQUIRED] Neo4j Bolt connection URI
NEO4J_URI=bolt://localhost:7687

# [OPTIONAL] Neo4j credentials
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=changeme

# [OPTIONAL] Neo4j database name
# NEO4J_DATABASE=cobol

# -----------------------------------------------------------------------------
# Ingestor (cobol-graph ingest)
# -----------------------------------------------------------------------------

# [REQUIRED for ingest] Root directory of COBOL source files (also set via --dir flag)
INGEST_ROOT_DIR=/path/to/cobol/source

# [OPTIONAL] Codebase identifier for multi-codebase support (also set via --codebase flag)
# INGEST_CODEBASE=default

# [OPTIONAL] Global worker pool size
# MAX_WORKERS=15

# [OPTIONAL] Per-pass worker overrides (0 = fall back to MAX_WORKERS)
# PASS1_MAX_WORKERS=0
# PASS2_MAX_WORKERS=0
# PASS5_MAX_WORKERS=0

# [OPTIONAL] Neo4j batch insert size
# INGEST_BATCH_SIZE=500

# [OPTIONAL] SQLite cache for incremental runs (skips unchanged files)
# INGEST_CACHE_DB=./cache.sqlite

# [OPTIONAL] Max tokens sent to LLM per chunk
# INGEST_TOKEN_LIMIT=30000

# [OPTIONAL] Pass 2 token limit (deep semantic pass)
# PASS2_TOKEN_LIMIT=20000

# [OPTIONAL] Overlap lines between Pass 2 chunks
# PASS2_OVERLAP_LINES=20

# [OPTIONAL] Programs per batch in Pass 3 (cross-cutting analysis)
# PASS3_BATCH_SIZE=50

# [OPTIONAL] Strip columns 1-6 and 73-80 from fixed-format COBOL
# STRIP_SEQUENCE_COLUMNS=true

# [OPTIONAL] Enable content-based detection of COBOL/copybook/JCL in .txt files (uses LLM)
# CONTENT_DETECT=false

# -----------------------------------------------------------------------------
# API Server (cobol-graph-api)
# -----------------------------------------------------------------------------

# [OPTIONAL] HTTP listen port
# API_PORT=8080

# [OPTIONAL] Log level
# API_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# MCP Server (cobol-graph-mcp)
# -----------------------------------------------------------------------------

# [OPTIONAL] Set to enable Streamable HTTP transport (default: stdio only)
# MCP_HTTP_PORT=9090

# -----------------------------------------------------------------------------
# Modernize Chat App (cobol-graph-modernize)
# -----------------------------------------------------------------------------

# [OPTIONAL] HTTP listen port
# MODERNIZE_PORT=8081

# [OPTIONAL] How the chat app connects to cobol-graph-mcp: "command" or "http"
# MCP_TRANSPORT=command

# [OPTIONAL] Path to cobol-graph-mcp binary (for command transport)
# MCP_SERVER_BIN=./bin/cobol-graph-mcp

# [OPTIONAL] MCP server URL (for http transport)
# MCP_SERVER_URL=http://localhost:9090/mcp

# [OPTIONAL] Override chat model (defaults to CLAUDE_OPUS_MODEL)
# MODERNIZE_CHAT_MODEL=

# [OPTIONAL] Max output tokens for chat responses
# MODERNIZE_CHAT_MAX_TOKENS=16384

# -----------------------------------------------------------------------------
# External DB Gap Analysis (cobol-graph external-db)
# -----------------------------------------------------------------------------
# Connects to an external database via MCP and maps schemas to COBOL DB2 tables.
# Provide ONE of: EXTDB_MCP_CMD, EXTDB_MCP_URL, or Oracle connection details.

# [CONDITIONAL] Shell command to start an external DB MCP server
# e.g. "npx -y @modelcontextprotocol/server-postgres postgres://user:pass@host/db"
# EXTDB_MCP_CMD=

# [CONDITIONAL] HTTP endpoint for an already-running external DB MCP server
# EXTDB_MCP_URL=

# [REQUIRED for external-db] Human-readable name for the database
# EXTDB_DATABASE_NAME=

# [REQUIRED for external-db] Database type: "oracle", "postgres", "mysql", etc.
# EXTDB_DATABASE_TYPE=

# [OPTIONAL] Path to cobol-graph-mcp binary (for COBOL graph queries)
# EXTDB_GRAPH_MCP_BIN=./bin/cobol-graph-mcp

# [OPTIONAL] HTTP endpoint for COBOL graph MCP (alternative to binary)
# EXTDB_GRAPH_MCP_URL=

# [OPTIONAL] Max LLM tool-use iterations per analysis run
# EXTDB_MAX_ITERATIONS=20

# [OPTIONAL] Max output tokens for analysis LLM calls
# EXTDB_MAX_TOKENS=16000

# --- Oracle SQLcl Auto-Launch (EXTDB_DATABASE_TYPE=oracle) ---
# When db-type is "oracle" and ORACLE_SERVICE is set, cobol-graph will
# automatically find and launch SQLcl in MCP server mode. No need to set
# EXTDB_MCP_CMD — just provide Oracle connection details below.
# Requires: Oracle SQLcl 24.x+ installed.

# [REQUIRED for oracle auto-launch] Oracle service name or SID
# ORACLE_SERVICE=ORCL

# [OPTIONAL] Oracle host
# ORACLE_HOST=localhost

# [OPTIONAL] Oracle port
# ORACLE_PORT=1521

# [OPTIONAL] Oracle username (empty = wallet auth or /nolog)
# ORACLE_USER=

# [OPTIONAL] Oracle password (visible in process list — prefer wallet for production)
# ORACLE_PASSWORD=

# [OPTIONAL] Oracle wallet directory (enables wallet authentication)
# ORACLE_WALLET_PATH=

# [OPTIONAL] TNS_ADMIN directory (defaults to ORACLE_WALLET_PATH if set)
# ORACLE_TNS_ADMIN=

# [OPTIONAL] Explicit path to SQLcl binary (auto-detected if omitted)
# ORACLE_SQLCL_PATH=
