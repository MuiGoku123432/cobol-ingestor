# LLM Provider — "anthropic" (direct API) or "copilot" (GitHub Copilot)
LLM_PROVIDER=anthropic

# For provider=anthropic: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# For provider=copilot: GitHub OAuth token (NOT a regular PAT).
# Optional — if omitted, run `cobol-graph auth login` to authenticate
# via the GitHub device flow, which caches the token automatically.
# COPILOT_GITHUB_TOKEN=gho_...
COPILOT_ACCOUNT_TYPE=individual   # individual, business, or enterprise

# For provider=vertex: Google Cloud Vertex AI (uses Application Default Credentials)
# VERTEX_PROJECT_ID=my-gcp-project
# VERTEX_REGION=us-east5

# For provider=bedrock: AWS Bedrock (uses standard AWS credential chain)
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0  # optional override

# LLM timeout settings (for large COBOL files that take longer to process)
# LLM_TIMEOUT=180s
# LLM_RESPONSE_HEADER_TIMEOUT=120s

# Claude model names (used by both providers)
CLAUDE_OPUS_MODEL=claude-opus-4-6
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_MAX_RETRIES=3
# Output token limits per pass (increase if responses are truncated)
# CLAUDE_PASS1_MAX_TOKENS=4096
# CLAUDE_PASS2_MAX_TOKENS=10000
# CLAUDE_PASS3_MAX_TOKENS=16000

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=cobol

# Ingestor
MAX_WORKERS=15
# DISABLE_RATE_LIMIT=true  # Remove the 2 req/s LLM rate limit (use with caution)
INGEST_ROOT_DIR=/path/to/cobol/source
INGEST_BATCH_SIZE=500
INGEST_CACHE_DB=./cache.sqlite
INGEST_TOKEN_LIMIT=150000

# API Server
API_PORT=8080
API_LOG_LEVEL=info

# MCP Server
# MCP_HTTP_PORT=9090  # Set to enable HTTP transport (default: stdio only)

# Modernize Chat App
MODERNIZE_PORT=8081
MCP_TRANSPORT=command           # "command" (subprocess) or "http"
MCP_SERVER_BIN=./bin/cobol-graph-mcp
# MCP_SERVER_URL=http://localhost:9090/mcp  # For http transport
# MODERNIZE_CHAT_MODEL=claude-opus-4-6      # Defaults to CLAUDE_OPUS_MODEL
# MODERNIZE_CHAT_MAX_TOKENS=16384
